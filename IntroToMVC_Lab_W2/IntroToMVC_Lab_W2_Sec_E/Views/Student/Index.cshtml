@{
}

<div>
    <h1>Hello, from Student Dashboard</h1>
<table class="table">
    <thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>Department</th>
</tr>
</thead>
<tbody>
            @foreach(var student in Model)
            {
                <tr>
                <td>@student.id</td>
                <td>@student.name</td>
                <td>@student.dept</td>
</tr>
            }
        </tbody>
</table>
</div>