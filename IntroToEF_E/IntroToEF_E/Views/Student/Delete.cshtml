@{
}

<div>
    <h3>Deleting Student</h3>
    <p>Name: @Model.name</p>
    <p>Department: @Model.department</p>
    <p>Program: @Model.program</p>
    <p>Credit Completed: @Model.credit_completed</p>
    <form method="post" action="/student/remove/@Model.id">
        Are you sure you want to remove this user? <button class="btn btn-danger">Yes, Confirm</button>
        <a href="/student" class="btn btn-success">No, Back</a>
    </form>
</div>